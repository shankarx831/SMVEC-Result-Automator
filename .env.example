# Flask Configuration
# Replace this with a long, random string to secure session cookies on the server
FLASK_SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Optional: Override the default port (default is 5001)
# FLASK_PORT=5001

# Default Super Admin Credentials (created on first run if no admin exists)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123
